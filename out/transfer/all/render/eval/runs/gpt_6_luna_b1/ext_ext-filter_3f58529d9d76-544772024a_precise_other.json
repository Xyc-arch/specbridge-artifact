{"key": "ext:ext-filter@3f58529d9d76-544772024a|precise_other", "final": "SELECT r.raceId, r.name, AVG(CAST(res.laps AS REAL)) AS average_laps FROM results AS res JOIN races AS r ON r.raceId = res.raceId WHERE res.positionOrder > 12 AND res.laps IS NOT NULL GROUP BY r.raceId, r.name ORDER BY average_laps DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "gpt-6-luna", "executes": true, "answer": [[800, "Indianapolis 500", 159.05555555555554], [786, "Indianapolis 500", 129.22727272727272], [818, "Indianapolis 500", 123.04761904761905], [809, "Indianapolis 500", 120.58620689655173], [748, "Indianapolis 500", 117.23809523809524], [757, "Indianapolis 500", 115.38095238095238], [778, "Indianapolis 500", 108.66666666666667], [794, "Indianapolis 500", 102.04761904761905], [835, "Indianapolis 500", 99.31818181818181], [826, "Indianapolis 500", 70.0952380952381]], "rows_answer": 10}