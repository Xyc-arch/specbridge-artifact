{"key": "eval12:eval12@01cfbb1e713f-9b7e954a5a|precise_other", "final": "WITH qc_data AS (\n  SELECT arcref, COUNT(*) as qc_count\n  FROM scanqc\n  GROUP BY arcref\n),\nstats AS (\n  SELECT \n    (SELECT COUNT(*) FROM scanqc) as total_qc,\n    COUNT(*) as num_projects\n  FROM qc_data\n),\nwith_dev AS (\n  SELECT \n    q.arcref,\n    q.qc_count as count,\n    CAST(q.qc_count AS REAL) / s.total_qc as share,\n    CAST(q.qc_count AS REAL) / s.total_qc - (1.0 / s.num_projects) as deviation\n  FROM qc_data q, stats s\n),\nranked_dev AS (\n  SELECT \n    deviation,\n    ROW_NUMBER() OVER (ORDER BY deviation DESC NULLS LAST) as dev_rank\n  FROM (SELECT DISTINCT deviation FROM with_dev)\n)\nSELECT \n  w.arcref,\n  w.count,\n  w.share,\n  w.deviation\nFROM with_dev w\nWHERE w.deviation IS NOT NULL\n  AND w.deviation >= (\n    SELECT MIN(deviation) \n    FROM with_dev \n    WHERE deviation IN (\n      SELECT deviation FROM ranked_dev WHERE dev_rank <= 10\n    )\n  )\nORDER BY \n  w.deviation DESC,\n  w.arcref", "turns": 4, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["PR7110", 3, 0.003, 0.0019440337909186907], ["PR8078", 3, 0.003, 0.0019440337909186907], ["PR1026", 2, 0.002, 0.0009440337909186907], ["PR1082", 2, 0.002, 0.0009440337909186907], ["PR1106", 2, 0.002, 0.0009440337909186907], ["PR1349", 2, 0.002, 0.0009440337909186907], ["PR1355", 2, 0.002, 0.0009440337909186907], ["PR1634", 2, 0.002, 0.0009440337909186907], ["PR1898", 2, 0.002, 0.0009440337909186907], ["PR2161", 2, 0.002, 0.0009440337909186907], ["PR2284", 2, 0.002, 0.0009440337909186907], ["PR2493", 2, 0.002, 0.0009440337909186907], ["PR2549", 2, 0.002, 0.0009440337909186907], ["PR3024", 2, 0.002, 0.0009440337909186907], ["PR3061", 2, 0.002, 0.0009440337909186907], ["PR3342", 2, 0.002, 0.0009440337909186907], ["PR3888", 2, 0.002, 0.0009440337909186907], ["PR4177", 2, 0.002, 0.0009440337909186907], ["PR4384", 2, 0.002, 0.0009440337909186907], ["PR4430", 2, 0.002, 0.0009440337909186907], ["PR4783