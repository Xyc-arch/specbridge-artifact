{"key": "eval12:eval12@01cfbb1e713f-e7b2c8e815|precise", "final": "WITH overall_avg AS (SELECT AVG(bandusagepct) as overall_avg FROM telescopes WHERE bandusagepct IS NOT NULL), station_avg AS (SELECT observstation, AVG(bandusagepct) as station_avg FROM telescopes WHERE bandusagepct IS NOT NULL GROUP BY observstation) SELECT s.observstation, s.station_avg, s.station_avg - o.overall_avg as diff FROM station_avg s CROSS JOIN overall_avg o WHERE s.station_avg > o.overall_avg ORDER BY diff DESC LIMIT 10", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-Elizabethfort                                   ", 99.9, 50.94478398314019], ["Observatory-Lake Todd                                       ", 99.6, 50.64478398314018], ["Observatory-West Dawnville                                  ", 99.6, 50.64478398314018], ["Observatory-Stephenbury                                     ", 99.3, 50.34478398314018], ["Observatory-North Stephanie                                 ", 99.0, 50.044783983140185], ["Observatory-Port Emily                                      ", 98.9, 49.94478398314019], ["Observatory-Herreraberg                                     ", 98.8, 49.84478398314018], ["Observatory-West Joseph                                     ", 98.6, 49.64478398314018], ["Observatory-Bakerchester                                    ", 98.5, 49.544783983140185], ["Observatory-Hineshaven                                      ", 98.5, 49.544783983140185]], "rows_answer": 10}