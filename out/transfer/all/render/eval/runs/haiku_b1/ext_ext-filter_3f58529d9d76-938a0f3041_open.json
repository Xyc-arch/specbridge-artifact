{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|open", "final": "WITH per_station AS (SELECT observstation, AVG(bandusagepct) AS avg_bandusage, COUNT(*) AS num_telescopes FROM telescopes GROUP BY observstation), avg_count AS (SELECT AVG(num_telescopes) AS avg_tel FROM per_station) SELECT p.observstation, p.avg_bandusage, p.num_telescopes, p.num_telescopes * 1.0 / a.avg_tel AS ratio FROM per_station p CROSS JOIN avg_count a ORDER BY ratio DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 2.8925184404636464], ["Observatory-New Michael                                     ", 55.366666666666674, 3, 2.8925184404636464], ["Observatory-East Brett                                      ", 68.65, 2, 1.9283456269757642], ["Observatory-East Jeffrey                                    ", 20.75, 2, 1.9283456269757642], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 1.9283456269757642], ["Observatory-East Samantha                                   ", 46.1, 2, 1.9283456269757642], ["Observatory-Jamesberg                                       ", 12.95, 2, 1.9283456269757642], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 1.9283456269757642], ["Observatory-Lake David                                      ", 9.6, 2, 1.9283456269757642], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 1.9283456269757642]], "rows_answer": 10}