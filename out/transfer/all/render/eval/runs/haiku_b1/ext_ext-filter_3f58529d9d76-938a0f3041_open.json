{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|open", "final": "WITH telescope_stats AS (\n  SELECT \n    observstation,\n    AVG(bandusagepct) as avg_bandwidth,\n    COUNT(*) as telescope_count\n  FROM telescopes\n  GROUP BY observstation\n),\nglobal_avg AS (\n  SELECT AVG(telescope_count) as avg_count\n  FROM telescope_stats\n)\nSELECT \n  ts.observstation,\n  ts.avg_bandwidth,\n  ts.telescope_count,\n  CAST(ts.telescope_count AS REAL) / ga.avg_count as ratio\nFROM telescope_stats ts\nCROSS JOIN global_avg ga\nORDER BY ratio DESC\nLIMIT 10", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 2.8925184404636464], ["Observatory-New Michael                                     ", 55.366666666666674, 3, 2.8925184404636464], ["Observatory-East Brett                                      ", 68.65, 2, 1.9283456269757642], ["Observatory-East Jeffrey                                    ", 20.75, 2, 1.9283456269757642], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 1.9283456269757642], ["Observatory-East Samantha                                   ", 46.1, 2, 1.9283456269757642], ["Observatory-Jamesberg                                       ", 12.95, 2, 1.9283456269757642], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 1.9283456269757642], ["Observatory-Lake David                                      ", 9.6, 2, 1.9283456269757642], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 1.9283456269757642]], "rows_answer": 10}