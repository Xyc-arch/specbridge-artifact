{"key": "eval12:eval12@01cfbb1e713f-6c4f216d01|precise", "final": "WITH account_orders AS (\n  SELECT account_id, COUNT(*) as order_count\n  FROM \"order\"\n  GROUP BY account_id\n),\naverage_orders AS (\n  SELECT AVG(order_count) as avg_orders\n  FROM account_orders\n),\naccount_with_diff AS (\n  SELECT \n    ao.account_id,\n    d.A3,\n    ao.order_count,\n    ao.order_count - avg.avg_orders as diff\n  FROM account_orders ao\n  JOIN account a ON ao.account_id = a.account_id\n  JOIN district d ON a.district_id = d.district_id\n  CROSS JOIN average_orders avg\n),\ntenth_value AS (\n  SELECT diff FROM account_with_diff\n  ORDER BY diff DESC\n  LIMIT 1 OFFSET 9\n)\nSELECT \n  account_id, \n  A3, \n  order_count, \n  diff\nFROM account_with_diff\nWHERE diff >= (SELECT diff FROM tenth_value)\nORDER BY diff DESC", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [[96, "north Moravia", 5, 3.278073443320915], [97, "north Moravia", 5, 3.278073443320915], [173, "south Moravia", 5, 3.278073443320915], [311, "east Bohemia", 5, 3.278073443320915], [365, "north Moravia", 5, 3.278073443320915], [368, "north Moravia", 5, 3.278073443320915], [378, "north Moravia", 5, 3.278073443320915], [689, "Prague", 5, 3.278073443320915], [1139, "north Bohemia", 5, 3.278073443320915], [1242, "north Moravia", 5, 3.278073443320915], [1244, "north Moravia", 5, 3.278073443320915], [1318, "south Moravia", 5, 3.278073443320915], [1404, "central Bohemia", 5, 3.278073443320915], [1766, "west Bohemia", 5, 3.278073443320915], [1828, "Prague", 5, 3.278073443320915], [1832, "north Moravia", 5, 3.278073443320915], [2035, "south Moravia", 5, 3.278073443320915], [2247, "west Bohemia", 5, 3.278073443320915], [2322, "north Bohemia", 5, 3.278073443320915], [2335, "north Moravia", 5, 3.278073443320915], [2371, "south Bohemia", 5, 3.278073443320915], [2482, "Prague", 5, 3.278073443320915], [2487, "east Bohemia", 5, 3.278073443320915], [2645, "south Moravia", 5, 3.278073443320915], [2932, "n