{"key": "eval12:eval12@01cfbb1e713f-65e2e1cfdd|precise_other", "final": "WITH total AS (\n  SELECT COUNT(*) as total_count FROM telescopes\n),\nstation_shares AS (\n  SELECT \n    observstation,\n    COUNT(*) as telescope_count,\n    CAST(COUNT(*) AS REAL) / (SELECT total_count FROM total) as share\n  FROM telescopes\n  GROUP BY observstation\n)\nSELECT \n  observstation,\n  telescope_count,\n  share\nFROM station_shares\nWHERE share >= (\n  SELECT share FROM station_shares \n  ORDER BY share DESC LIMIT 1 OFFSET 9\n)\nORDER BY share DESC", "turns": 3, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", 3, 0.003161222339304531], ["Observatory-New Michael                                     ", 3, 0.003161222339304531], ["Observatory-East Brett                                      ", 2, 0.002107481559536354], ["Observatory-East Jeffrey                                    ", 2, 0.002107481559536354], ["Observatory-East Kevin                                      ", 2, 0.002107481559536354], ["Observatory-East Samantha                                   ", 2, 0.002107481559536354], ["Observatory-Jamesberg                                       ", 2, 0.002107481559536354], ["Observatory-Juanville                                       ", 2, 0.002107481559536354], ["Observatory-Lake David                                      ", 2, 0.002107481559536354], ["Observatory-Lake Josephview                                 ", 2, 0.002107481559536354], ["Observatory-Lake Kathryn                                    ", 2, 0.002107481559536354], ["Observatory-Michaelport                                     ", 2, 0.002107481559536354], ["Observatory-Michaelton                                      ", 2, 0.002107481559536354], ["Observatory-New Steve                                       ", 2, 0.002107481559536354], ["Observatory-North James                                     ", 2, 0.002107481559536354], ["Observatory