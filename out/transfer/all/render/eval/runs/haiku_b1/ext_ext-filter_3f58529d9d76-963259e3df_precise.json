{"key": "ext:ext-filter@3f58529d9d76-963259e3df|precise", "final": "SELECT t.observstation, o.lunarstage, AVG(t.bandusagepct) as avg_bandwidth, COUNT(*) as telescope_count FROM telescopes t JOIN observatories o ON t.observstation = o.observstation WHERE t.observstation IN (SELECT DISTINCT observstation FROM telescopes WHERE equipstatus IS NOT NULL AND equipstatus != 'Maintenance') GROUP BY t.observstation, o.lunarstage ORDER BY telescope_count DESC LIMIT 10", "turns": 3, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", "Last Quarter", 57.166666666666664, 3], ["Observatory-New Michael                                     ", "First Quarter", 55.366666666666674, 3], ["Observatory-East Brett                                      ", "First Quarter", 68.65, 2], ["Observatory-East Jeffrey                                    ", "Last Quarter", 20.75, 2], ["Observatory-East Kevin                                      ", "First Quarter", 30.700000000000003, 2], ["Observatory-East Samantha                                   ", "Full", 46.1, 2], ["Observatory-Jamesberg                                       ", "Full", 12.95, 2], ["Observatory-Juanville                                       ", "New", 9.299999999999999, 2], ["Observatory-Lake David                                      ", "Full", 9.6, 2], ["Observatory-Lake Josephview                                 ", "First Quarter", 62.099999999999994, 2]], "rows_answer": 10}