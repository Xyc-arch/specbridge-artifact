{"key": "eval12:eval12@01cfbb1e713f-be1e5ce229|open", "final": "WITH event_ratios AS (\n  SELECT \n    e.event_id,\n    e.location,\n    AVG(CASE WHEN b.amount = 0 THEN NULL ELSE (b.spent - b.amount) / CAST(b.amount AS FLOAT) END) as avg_ratio\n  FROM event e \n  LEFT JOIN budget b ON e.event_id = b.link_to_event \n  GROUP BY e.event_id, e.location\n),\nranked_events AS (\n  SELECT \n    event_id,\n    location,\n    avg_ratio,\n    RANK() OVER (PARTITION BY location ORDER BY avg_ratio DESC NULLS LAST) as rank\n  FROM event_ratios\n)\nSELECT event_id, location, avg_ratio, rank\nFROM ranked_events\nWHERE rank <= 3\nORDER BY location, rank", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["recJ4Witp9tpjaugn", null, 0.009999999999999964, 1], ["recc8dizaKrSz3GmH", null, 0.009999999999999964, 1], ["rec0akZnLLpGUloLH", null, -1.0, 3], ["rec180D2MI4EpckHy", null, -1.0, 3], ["recLrY8kyOR1PcZeF", null, -1.0, 3], ["recWJFyajeK4jCNYz", null, -1.0, 3], ["recqh5zxHuDpKUu0i", "100 W. Main Street", null, 1], ["recvCUOytx5jPw7kh", "100 W. Main Street", null, 1], ["recsgSUqFCJqekzL5", "1308 106th Ave.", null, 1], ["recSdU7jGu57676tT", "258 S. Maple St.", null, 1], ["recoVo6dFSzG1ypX7", "45 N. Smith St.", null, 1], ["rec5XDvJLyxDsGZWc", "900 E. Washington St.", null, 1], ["recJcyZUsdhK2ukaY", "900 E. Washington St.", null, 1], ["recyYo8ZxGg9oJGys", "Campus Baseball Stadium", null, 1], ["recLKj8BbTNqxFbTb", "Campus Common", -0.01626666666666665, 1], ["recGxVCwaLW3mDIa3", "Campus Football stadium", null, 1], ["recIuIXdbLe5j5vCA", "Campus Football stadium", null, 1], ["rec2N69DMcrqN9PJC", "Campus Soccer/Lacrosse stadium", null, 1], ["recQym2V7XkIEFFnr", "Campus Soccer/Lacrosse stadium", null, 1], ["receBpqENOUMQYsIP", "Campus Soccer/Lacrosse stadium", null, 1], ["reckYL4xtQWpkTJ8k", "Conference Room BA 452", null, 1], ["rectsBOijA23838qh", "Conference Room BA 452", null, 1], ["recmbOVHSyzXQZpQr", "MU 215", 0.0740151515151515, 1], ["recMKjJbWRgSQqf4Y", "MU 21