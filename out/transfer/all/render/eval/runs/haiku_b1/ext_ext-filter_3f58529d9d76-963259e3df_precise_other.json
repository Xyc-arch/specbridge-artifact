{"key": "ext:ext-filter@3f58529d9d76-963259e3df|precise_other", "final": "SELECT t.observstation, o.lunarstage, AVG(t.bandusagepct) as avg_bandwidth, COUNT(*) as telescope_count FROM telescopes t INNER JOIN observatories o ON t.observstation = o.observstation WHERE t.observstation NOT IN (SELECT DISTINCT observstation FROM telescopes WHERE equipstatus = 'Maintenance') GROUP BY t.observstation, o.lunarstage ORDER BY telescope_count DESC LIMIT 10", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-New Michael                                     ", "First Quarter", 55.366666666666674, 3], ["Observatory-East Jeffrey                                    ", "Last Quarter", 20.75, 2], ["Observatory-East Kevin                                      ", "First Quarter", 30.700000000000003, 2], ["Observatory-Juanville                                       ", "New", 9.299999999999999, 2], ["Observatory-Michaelport                                     ", "First Quarter", 54.150000000000006, 2], ["Observatory-North Michael                                   ", "New", 72.4, 2], ["Observatory-Port Jesse                                      ", "Last Quarter", 66.85, 2], ["Observatory-Port Nicholas                                   ", "Full", 47.75, 2], ["Observatory-South Robert                                    ", "Full", 37.8, 2], ["Observatory-Sullivanmouth                                   ", "New", 56.55, 2]], "rows_answer": 10}