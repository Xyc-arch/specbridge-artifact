{"key": "eval12:eval12@01cfbb1e713f-ff5d7b5c34|explicit", "final": "WITH step1 AS (\n  SELECT \n    f.orderslink,\n    u.acctscope,\n    AVG(f.feerate) as avg_feerate\n  FROM fees f\n  JOIN orders o ON f.orderslink = o.recordvault\n  JOIN users u ON o.userlink = u.userstamp\n  GROUP BY f.orderslink, u.acctscope\n),\nstep2 AS (\n  SELECT AVG(avg_feerate) as overall_avg\n  FROM step1\n),\nstep3 AS (\n  SELECT \n    s1.orderslink,\n    s1.acctscope,\n    s1.avg_feerate,\n    s1.avg_feerate - s2.overall_avg as difference\n  FROM step1 s1\n  CROSS JOIN step2 s2\n  WHERE s1.avg_feerate > s2.overall_avg\n),\nstep4 AS (\n  SELECT \n    orderslink,\n    acctscope,\n    avg_feerate,\n    difference,\n    RANK() OVER (PARTITION BY acctscope ORDER BY difference DESC) as rank\n  FROM step3\n)\nSELECT \n  orderslink,\n  acctscope,\n  avg_feerate,\n  difference,\n  rank\nFROM step4\nWHERE rank <= 3", "turns": 2, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["OB696050                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB789898                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB831859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB867292                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB889157                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB913859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB953471                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB236106                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB258847                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB494562                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB619793                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB797782                            ", "Margin", 0.002, 0.0009889889889889913, 1]