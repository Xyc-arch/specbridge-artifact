{"key": "eval12:eval12@01cfbb1e713f-c1a8ce4d18|explicit", "final": "WITH s1 AS (SELECT c.location AS loc, COUNT(DISTINCT q.raceId) AS n FROM qualifying q JOIN races r ON r.raceId = q.raceId JOIN circuits c ON c.circuitId = r.circuitId GROUP BY c.location), s2 AS (SELECT SUM(n) AS total FROM s1), s3 AS (SELECT s1.loc AS loc, s1.n AS n, CAST(s1.n AS REAL) / s2.total AS share FROM s1 JOIN s2 ON s2.total IS NOT NULL), s4 AS (SELECT AVG(share) AS av FROM s3) SELECT s3.loc, s3.n, s3.share, s3.share - s4.av FROM s3 JOIN s4 ON s4.av IS NOT NULL WHERE s3.share > s4.av", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Budapest", 17, 0.04927536231884058, 0.020703933747412015], ["Hockenheim", 13, 0.03768115942028986, 0.00910973084886129], ["Imola", 10, 0.028985507246376812, 0.0004140786749482449], ["Kuala Lumpur", 16, 0.0463768115942029, 0.017805383022774332], ["Marina Bay", 10, 0.028985507246376812, 0.0004140786749482449], ["Melbourne", 20, 0.057971014492753624, 0.029399585921325057], ["Monte-Carlo", 18, 0.05217391304347826, 0.02360248447204969], ["Montmel_", 19, 0.05507246376811594, 0.026501035196687374], ["Montreal", 17, 0.04927536231884058, 0.020703933747412015], ["Monza", 17, 0.04927536231884058, 0.020703933747412015], ["N_rburg", 10, 0.028985507246376812, 0.0004140786749482449], ["Sakhir", 13, 0.03768115942028986, 0.00910973084886129], ["Shanghai", 14, 0.04057971014492753, 0.012008281573498966], ["Silverstone", 20, 0.057971014492753624, 0.029399585921325057], ["Spa", 16, 0.0463768115942029, 0.017805383022774332], ["Suzuka", 17, 0.04927536231884058, 0.020703933747412015], ["S\u0323o Paulo", 21, 0.06086956521739131, 0.03229813664596274]], "rows_answer": 17}