{"key": "eval12:eval12@01cfbb1e713f-c1a8ce4d18|open", "final": "WITH c AS (SELECT ci.location AS city, COUNT(*) AS cnt FROM qualifying q JOIN races r ON r.raceId = q.raceId JOIN circuits ci ON ci.circuitId = r.circuitId GROUP BY ci.location), s AS (SELECT city, cnt, cnt * 1.0 / (SELECT SUM(cnt) FROM c) AS share FROM c) SELECT city, cnt AS qualifying_count, share, share - (SELECT AVG(share) FROM s) AS above_avg_by FROM s WHERE share > (SELECT AVG(share) FROM s) ORDER BY share DESC", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["S\u0323o Paulo", 457, 0.06080361894624801, 0.03223219037481944], ["Silverstone", 437, 0.05814262905800958, 0.02957120048658101], ["Melbourne", 430, 0.05721128259712613, 0.02863985402569756], ["Montmel_", 415, 0.05521554018094731, 0.026644111609518746], ["Monte-Carlo", 389, 0.05175625332623736, 0.02318482475480879], ["Budapest", 372, 0.0494944119212347, 0.020922983349806135], ["Montreal", 372, 0.0494944119212347, 0.020922983349806135], ["Suzuka", 372, 0.0494944119212347, 0.020922983349806135], ["Monza", 370, 0.04922831293241086, 0.020656884360982293], ["Spa", 350, 0.04656732304417243, 0.017995894472743863], ["Kuala Lumpur", 345, 0.04590207557211282, 0.017330647000684256], ["Shanghai", 302, 0.04018094731240021, 0.011609518740971644], ["Hockenheim", 287, 0.038185204896221396, 0.009613776324792829], ["Sakhir", 279, 0.03712080894092602, 0.008549380369497456], ["Imola", 222, 0.029536987759446513, 0.0009655591880179462], ["Marina Bay", 218, 0.02900478978179883, 0.00043336121037026304]], "rows_answer": 16}