{"key": "ext:ext-filter@3f58529d9d76-9acddf6c90|open", "final": "WITH f AS (SELECT driverId, AVG(points) AS avg_points, AVG(wins) AS avg_wins FROM driverStandings WHERE points > 1.0 GROUP BY driverId), m AS (SELECT AVG(avg_wins) AS mean_wins FROM f) SELECT f.driverId, f.avg_points, f.avg_wins, f.avg_wins - m.mean_wins AS diff FROM f, m WHERE m.mean_wins IS NOT NULL ORDER BY diff DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[1, 129.10731707317072, 2.892682926829268, 2.663782081384107], [30, 47.42483660130719, 2.7745098039215685, 2.5456089584764072], [102, 35.90909090909091, 2.5584415584415585, 2.329540712996397], [117, 34.66243654822335, 2.3959390862944163, 2.167038240849255], [20, 130.59459459459458, 2.3405405405405406, 2.1116396950953793], [647, 19.333333333333332, 2.0, 1.7710991545548387], [71, 32.666666666666664, 1.9777777777777779, 1.7488769323326165], [328, 26.52577319587629, 1.9690721649484537, 1.7401713195032924], [373, 19.94736842105263, 1.9210526315789473, 1.692151786133786], [579, 18.246451612903225, 1.7419354838709677, 1.5130346384258064]], "rows_answer": 10}