{"key": "eval12:eval12@01cfbb1e713f-fea75e8f25|explicit", "final": "WITH s1 AS (SELECT equipref, AVG(humepct) AS a FROM scanenvironment GROUP BY equipref), s2 AS (SELECT AVG(a) AS b FROM s1), s3 AS (SELECT s1.equipref AS e, s1.a AS a, s1.a - s2.b AS d FROM s1 JOIN s2 ON s2.b IS NOT NULL WHERE s1.a > s2.b), s4 AS (SELECT AVG(a) AS c FROM s3) SELECT s3.e, s3.a, s3.d, s3.a - s4.c AS x FROM s3 JOIN s4 ON s4.c IS NOT NULL ORDER BY x DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["SN16838                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN21406                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN88255                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN41485                                           ", 89.8, 34.15704934541804, 17.23101761252444], ["SN64180                                           ", 89.7, 34.057049345418044, 17.131017612524445], ["SN66318                                           ", 89.6, 33.957049345418035, 17.031017612524437], ["SN45393                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN48591                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN63864                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN32865                                           ", 89.3, 33.65704934541804, 16.73101761252444]], "rows_answer": 10}