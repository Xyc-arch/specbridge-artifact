{"key": "eval12:eval12@01cfbb1e713f-307e76f490|precise", "final": "WITH t AS (SELECT team_id, SUM(COALESCE(games,0)) AS total FROM home_game GROUP BY team_id) SELECT team_id, total, total * 1.0 / (SELECT SUM(total) FROM t) AS fraction_of_sum, total * 1.0 / (SELECT AVG(total) FROM t) AS ratio_to_avg FROM t ORDER BY ratio_to_avg DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["CHN", 10450, 0.05013264762745446, 7.41963184886326], ["PHI", 10076, 0.04833842655447188, 7.154087130061838], ["PIT", 9897, 0.04747969507836525, 7.026994871598056], ["CIN", 9735, 0.046702519105576, 6.911972827625248], ["SLN", 9566, 0.04589176145495018, 6.791980695332627], ["DET", 8917, 0.042778260181245115, 6.331182506824277], ["CLE", 8910, 0.04274467850340854, 6.326212418504464], ["BOS", 8898, 0.04268710991283156, 6.317692267099071], ["CHA", 8895, 0.042672717765187315, 6.315562229247723], ["NYA", 8740, 0.04192912347023464, 6.205510273594727]], "rows_answer": 10}