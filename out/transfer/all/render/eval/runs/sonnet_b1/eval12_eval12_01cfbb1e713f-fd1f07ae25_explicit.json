{"key": "eval12:eval12@01cfbb1e713f-fd1f07ae25|explicit", "final": "WITH s1 AS (SELECT f.orderslink AS c1, o.ordertune AS c2, AVG(f.rebtotal) AS c3, AVG((f.rebrate - f.feerate) / NULLIF(f.feerate, 0)) AS c4 FROM fees f JOIN orders o ON o.recordvault = f.orderslink GROUP BY f.orderslink, o.ordertune), s2 AS (SELECT AVG(c3) AS d1 FROM s1) SELECT s1.c1, s1.c2, s1.c3, s1.c4, s1.c3 - s2.d1 AS diff FROM s1 JOIN s2 ON s2.d1 IS NOT NULL WHERE s1.c3 > s2.d1 ORDER BY diff DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["OB322795                            ", "Stop", 295.382262, 0.0, 265.16370743793794], ["OB403979                            ", "Stop", 293.400495, -0.5, 263.1819404379379], ["OB745580                            ", "Market", 280.41416, -0.3333333333333333, 250.19560543793793], ["OB514539                            ", "Stop", 274.7333, 1.0, 244.51474543793793], ["OB725569                            ", "Limit", 258.70403, 0.11111111111111116, 228.48547543793794], ["OB954989                            ", "Limit", 253.695218, -0.6315789473684211, 223.47666343793796], ["OB397210                            ", "StopLimit", 250.88823, -0.5, 220.66967543793794], ["OB181823                            ", "Stop", 245.978352, 0.7999999999999999, 215.75979743793795], ["OB748142                            ", "Market", 245.801466, 2.0000000000000004, 215.58291143793795], ["OB188015                            ", "StopLimit", 229.315368, -0.5555555555555556, 199.09681343793795]], "rows_answer": 10}