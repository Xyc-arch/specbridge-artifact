{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|precise_other", "final": "WITH t AS (SELECT o.observstation AS observstation, AVG(te.bandusagepct) AS avg_bw, COUNT(te.telescregistry) AS n FROM observatories o LEFT JOIN telescopes te ON te.observstation = o.observstation GROUP BY o.observstation) SELECT observstation, avg_bw, n, n * 1.0 / (SELECT AVG(n * 1.0) FROM t) AS ratio FROM t ORDER BY ratio DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 3.0442571127502633], ["Observatory-New Michael                                     ", 55.36666666666667, 3, 3.0442571127502633], ["Observatory-East Brett                                      ", 68.65, 2, 2.029504741833509], ["Observatory-East Jeffrey                                    ", 20.75, 2, 2.029504741833509], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 2.029504741833509], ["Observatory-East Samantha                                   ", 46.1, 2, 2.029504741833509], ["Observatory-Jamesberg                                       ", 12.95, 2, 2.029504741833509], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 2.029504741833509], ["Observatory-Lake David                                      ", 9.6, 2, 2.029504741833509], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 2.029504741833509]], "rows_answer": 10}