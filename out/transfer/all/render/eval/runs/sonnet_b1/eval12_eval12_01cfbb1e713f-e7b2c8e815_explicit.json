{"key": "eval12:eval12@01cfbb1e713f-e7b2c8e815|explicit", "final": "WITH s1 AS (SELECT observstation, AVG(bandusagepct) AS a FROM telescopes GROUP BY observstation), s2 AS (SELECT AVG(bandusagepct) AS b FROM telescopes) SELECT s1.observstation, s1.a, s1.a - s2.b FROM s1 JOIN s2 ON s2.b IS NOT NULL WHERE s1.a > s2.b ORDER BY s1.a - s2.b DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-Elizabethfort                                   ", 99.9, 50.94478398314019], ["Observatory-Lake Todd                                       ", 99.6, 50.64478398314018], ["Observatory-West Dawnville                                  ", 99.6, 50.64478398314018], ["Observatory-Stephenbury                                     ", 99.3, 50.34478398314018], ["Observatory-North Stephanie                                 ", 99.0, 50.044783983140185], ["Observatory-Port Emily                                      ", 98.9, 49.94478398314019], ["Observatory-Herreraberg                                     ", 98.8, 49.84478398314018], ["Observatory-West Joseph                                     ", 98.6, 49.64478398314018], ["Observatory-Bakerchester                                    ", 98.5, 49.544783983140185], ["Observatory-Hineshaven                                      ", 98.5, 49.544783983140185]], "rows_answer": 10}