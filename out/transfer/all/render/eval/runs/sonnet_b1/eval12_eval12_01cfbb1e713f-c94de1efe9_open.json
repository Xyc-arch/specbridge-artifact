{"key": "eval12:eval12@01cfbb1e713f-c94de1efe9|open", "final": "WITH p AS (SELECT l.ID AS ID, pt.SEX AS SEX, AVG(l.WBC) AS avg_wbc, AVG(l.HGB * 1.0 / NULLIF(l.HCT, 0)) AS ratio FROM Laboratory l JOIN Patient pt ON pt.ID = l.ID GROUP BY l.ID, pt.SEX), m AS (SELECT AVG(ratio) AS mr FROM p) SELECT p.ID, p.SEX, p.avg_wbc, p.ratio, p.ratio - m.mr AS gap FROM p, m WHERE p.ratio > m.mr ORDER BY gap DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[1936676, "F", 16.2, 0.34545454545454546, 0.01717598587215602], [2076007, "M", 3.5, 0.3452115812917595, 0.016933021709370055], [5400658, "F", 4.783333333333332, 0.3417757665556207, 0.013497206973231257], [2307640, "M", 8.329999999999998, 0.34171080409625965, 0.013432244513870206], [5449095, "F", 4.614285714285715, 0.34145619590997744, 0.013177636327588005], [5093188, "M", 7.7, 0.3406286227141842, 0.012350063131794764], [57266, "M", 8.786666666666669, 0.3398916696366638, 0.011613110054274345], [1137040, "M", 6.3, 0.3398707397072195, 0.011592180124830043], [4923624, "F", 7.800000000000001, 0.33966580976863747, 0.011387250186248032], [5105683, "F", 8.207142857142857, 0.33927624494372294, 0.010997685361333498]], "rows_answer": 10}