{"key": "eval12:eval12@01cfbb1e713f-c078054b47|precise_other", "final": "WITH per AS (SELECT transref, AVG(anlycount) AS avg_cnt FROM sentimentandfundamentals GROUP BY transref), overall AS (SELECT AVG(avg_cnt) AS o FROM per WHERE avg_cnt IS NOT NULL), kept AS (SELECT p.transref, p.avg_cnt FROM per p, overall WHERE p.avg_cnt > overall.o), keptavg AS (SELECT AVG(avg_cnt) AS k FROM kept), ranked AS (SELECT kept.transref, kept.avg_cnt AS avg_anlycount, kept.avg_cnt - overall.o AS diff_overall, kept.avg_cnt - keptavg.k AS diff_kept, RANK() OVER (ORDER BY kept.avg_cnt - keptavg.k DESC) AS rnk FROM kept, overall, keptavg) SELECT transref, avg_anlycount, diff_overall, diff_kept FROM ranked WHERE rnk <= 10 ORDER BY diff_kept DESC", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["IT109277", 30.0, 14.64014014014014, 6.909722222222221], ["IT130699", 30.0, 14.64014014014014, 6.909722222222221], ["IT142180", 30.0, 14.64014014014014, 6.909722222222221], ["IT162367", 30.0, 14.64014014014014, 6.909722222222221], ["IT173315", 30.0, 14.64014014014014, 6.909722222222221], ["IT198423", 30.0, 14.64014014014014, 6.909722222222221], ["IT221456", 30.0, 14.64014014014014, 6.909722222222221], ["IT227749", 30.0, 14.64014014014014, 6.909722222222221], ["IT270960", 30.0, 14.64014014014014, 6.909722222222221], ["IT303884", 30.0, 14.64014014014014, 6.909722222222221], ["IT375175", 30.0, 14.64014014014014, 6.909722222222221], ["IT422609", 30.0, 14.64014014014014, 6.909722222222221], ["IT434694", 30.0, 14.64014014014014, 6.909722222222221], ["IT533139", 30.0, 14.64014014014014, 6.909722222222221], ["IT561739", 30.0, 14.64014014014014, 6.909722222222221], ["IT575464", 30.0, 14.64014014014014, 6.909722222222221], ["IT578437", 30.0, 14.64014014014014, 6.909722222222221], ["IT623201", 30.0, 14.64014014014014, 6.909722222222221], ["IT627825", 30.0, 14.64014014014014, 6.909722222222221], ["IT650563", 30.0, 14.64014014014014, 6.909722222222221], ["IT652442", 30.0, 14.6401401