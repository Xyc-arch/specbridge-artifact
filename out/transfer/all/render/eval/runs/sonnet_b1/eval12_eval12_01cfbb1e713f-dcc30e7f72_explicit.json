{"key": "eval12:eval12@01cfbb1e713f-dcc30e7f72|explicit", "final": "WITH s1 AS (SELECT team_id AS c1, AVG(w) AS c2, AVG((g - l) * 1.0 / l) AS c3 FROM manager_half GROUP BY team_id), s2 AS (SELECT AVG(c2) AS c1 FROM s1) SELECT s1.c1, s1.c2, s1.c3, s1.c2 - s2.c1 AS diff FROM s1 JOIN s2 ON s2.c1 IS NOT NULL WHERE s1.c2 > s2.c1 ORDER BY diff DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["BSN", 51.0, 2.1853146853146854, 24.54419191919192], ["BRO", 47.5, 1.7121212121212122, 21.04419191919192], ["CL4", 46.5, 1.8386034255599473, 20.04419191919192], ["CIN", 37.0, 1.4337090546767968, 10.54419191919192], ["PHI", 36.5, 1.3195767195767196, 10.04419191919192], ["NY1", 35.5, 0.9280326838466373, 9.04419191919192], ["OAK", 32.0, 1.4179841897233203, 5.5441919191919204], ["LAN", 31.5, 1.3763736263736264, 5.0441919191919204], ["ML4", 31.0, 1.3245454545454547, 4.5441919191919204], ["HOU", 30.5, 1.3077586206896552, 4.0441919191919204]], "rows_answer": 10}