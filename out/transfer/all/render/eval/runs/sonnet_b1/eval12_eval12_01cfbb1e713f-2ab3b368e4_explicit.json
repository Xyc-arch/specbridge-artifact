{"key": "eval12:eval12@01cfbb1e713f-2ab3b368e4|explicit", "final": "SELECT s1.ID, s1.a, s1.r, s1.a - s2.b AS diff FROM (SELECT ID, AVG(GOT) AS a, AVG(RBC) AS r FROM Laboratory GROUP BY ID) s1 JOIN (SELECT AVG(GOT) AS b FROM Laboratory) s2 ON s2.b IS NOT NULL ORDER BY diff DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[4618443, 487.25531914893617, 3.8938775510204096, 458.4532265793316], [3334746, 122.59649122807018, 3.8169811320754707, 93.79439865846564], [2343945, 106.39024390243902, 4.090677966101695, 77.58815133283449], [5186147, 102.04081632653062, 3.8745098039215686, 73.23872375692608], [4652830, 88.29166666666667, 3.9666666666666663, 59.48957409706213], [1650222, 73.5, 3.766666666666666, 44.69790743039546], [81043, 72.078125, 5.01641791044776, 43.27603243039546], [5093188, 72.0, 4.85, 43.19790743039546], [1137040, 70.78571428571429, 5.307142857142857, 41.98362171610975], [4632421, 70.4, 4.068965517241379, 41.597907430395466]], "rows_answer": 10}