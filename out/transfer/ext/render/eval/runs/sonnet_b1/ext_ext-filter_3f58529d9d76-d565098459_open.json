{"key": "ext:ext-filter@3f58529d9d76-d565098459|open", "final": "SELECT t.observstation AS station, o.lunarstage AS moon_phase, COUNT(*) AS telescope_count FROM telescopes t JOIN observatories o ON t.observstation = o.observstation WHERE t.bandusagepct > 47.6 GROUP BY t.observstation, o.lunarstage ORDER BY telescope_count DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-East Brett                                      ", "First Quarter", 2], ["Observatory-East Michael                                    ", "Last Quarter", 2], ["Observatory-New Michael                                     ", "First Quarter", 2], ["Observatory-North Michael                                   ", "New", 2], ["Observatory-Ryanland                                        ", "Full", 2], ["Observatory-Sullivanmouth                                   ", "New", 2], ["Observatory-West Richard                                    ", "New", 2], ["Observatory-Adrianfurt                                      ", "First Quarter", 1], ["Observatory-Aguirreside                                     ", "Last Quarter", 1], ["Observatory-Alexanderville                                  ", "New", 1]], "rows_answer": 10}