{"key": "ext:ext-filter@3f58529d9d76-9acddf6c90|explicit", "final": "WITH s1 AS (SELECT driverId, AVG(points) AS ap, AVG(wins) AS aw FROM driverStandings WHERE points >= 1.0 GROUP BY driverId), s2 AS (SELECT AVG(aw) AS b FROM s1) SELECT s1.driverId, s1.ap, s1.aw, s1.aw - s2.b AS diff FROM s1 JOIN s2 ON s2.b IS NOT NULL ORDER BY diff DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[1, 128.48543689320388, 2.878640776699029, 2.6782586742510572], [30, 47.12337662337662, 2.7564935064935066, 2.556111404045535], [102, 35.68387096774194, 2.541935483870968, 2.341553381422996], [117, 34.49242424242424, 2.3838383838383836, 2.183456281390412], [20, 124.58247422680412, 2.231958762886598, 2.0315766604386263], [328, 26.26530612244898, 1.9489795918367347, 1.7485974893887632], [71, 31.97826086956522, 1.934782608695652, 1.7344005062476806], [647, 18.678571428571427, 1.9285714285714286, 1.728189326123457], [373, 19.94736842105263, 1.9210526315789473, 1.7206705291309758], [579, 18.246451612903225, 1.7419354838709677, 1.5415533814229962]], "rows_answer": 10}