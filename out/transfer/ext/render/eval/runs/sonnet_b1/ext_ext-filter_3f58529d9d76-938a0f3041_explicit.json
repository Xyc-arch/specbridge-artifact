{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|explicit", "final": "WITH s1 AS (SELECT observstation AS o, AVG(bandusagepct) AS a, COUNT(*) AS c FROM telescopes GROUP BY observstation), s2 AS (SELECT AVG(c) AS m FROM s1) SELECT s1.o, s1.a, s1.c, s1.c * 1.0 / NULLIF(s2.m, 0) AS r FROM s1 JOIN s2 ON s2.m IS NOT NULL ORDER BY r DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 2.8925184404636464], ["Observatory-New Michael                                     ", 55.366666666666674, 3, 2.8925184404636464], ["Observatory-East Brett                                      ", 68.65, 2, 1.9283456269757642], ["Observatory-East Jeffrey                                    ", 20.75, 2, 1.9283456269757642], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 1.9283456269757642], ["Observatory-East Samantha                                   ", 46.1, 2, 1.9283456269757642], ["Observatory-Jamesberg                                       ", 12.95, 2, 1.9283456269757642], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 1.9283456269757642], ["Observatory-Lake David                                      ", 9.6, 2, 1.9283456269757642], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 1.9283456269757642]], "rows_answer": 10}