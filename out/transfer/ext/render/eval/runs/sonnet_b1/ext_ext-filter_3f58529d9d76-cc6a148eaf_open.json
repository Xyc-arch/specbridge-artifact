{"key": "ext:ext-filter@3f58529d9d76-cc6a148eaf|open", "final": "SELECT t.account_id, a.frequency, AVG(CASE WHEN t.type='PRIJEM' THEN t.amount WHEN t.type='VYDAJ' THEN -t.amount END) AS avg_signed_amount, AVG(t.balance) AS avg_balance FROM trans t JOIN account a ON a.account_id = t.account_id WHERE t.amount > 2400 GROUP BY t.account_id, a.frequency ORDER BY avg_balance DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[8212, "POPLATEK PO OBRATU", 2999.137777777778, 84132.85393258427], [4321, "POPLATEK MESICNE", 2567.4712643678163, 82425.08305647841], [1953, "POPLATEK TYDNE", 1431.1940298507463, 80165.3], [2838, "POPLATEK TYDNE", 1130.963210702341, 79380.62706270628], [2170, "POPLATEK PO OBRATU", 1626.1149425287356, 79132.67741935483], [2471, "POPLATEK MESICNE", 1342.4010152284263, 78956.59905660378], [211, "POPLATEK MESICNE", 1321.2545454545455, 78824.45614035087], [1610, "POPLATEK MESICNE", 537.6172839506173, 78707.51851851853], [3785, "POPLATEK MESICNE", 346.42857142857144, 78330.73412698413], [8856, "POPLATEK MESICNE", 1300.2281553398059, 78274.58411214953]], "rows_answer": 10}