{"key": "ext:ext-filter@3f58529d9d76-878035e03f|explicit", "final": "WITH s1 AS (SELECT orderslink AS k, AVG(rebtotal) AS c2, AVG(CAST(rebrate AS REAL) / feerate) AS c3 FROM fees WHERE rebrate >= 0.0005 GROUP BY orderslink), s2 AS (SELECT AVG(c3) AS c1 FROM s1) SELECT s1.k, s1.c2, s1.c3, s1.c3 / s2.c1 AS ratio FROM s1 CROSS JOIN s2 WHERE s2.c1 IS NOT NULL ORDER BY (s1.c3 / s2.c1) IS NULL, s1.c3 / s2.c1 DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["OB860960                            ", 114.51339, 10.0, 8.073313772285672], ["OB555670                            ", 218.028078, 9.0, 7.265982395057105], ["OB668095                            ", 64.010601, 9.0, 7.265982395057105], ["OB695333                            ", 22.13802, 9.0, 7.265982395057105], ["OB520751                            ", 6.60056, 8.0, 6.458651017828538], ["OB524281                            ", 4.41552, 8.0, 6.458651017828538], ["OB547421                            ", 5.068352, 8.0, 6.458651017828538], ["OB144339                            ", 111.284873, 7.0, 5.651319640599971], ["OB313403                            ", 123.058313, 7.0, 5.651319640599971], ["OB618843                            ", 32.115083, 7.0, 5.651319640599971]], "rows_answer": 10}