{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|precise", "final": "WITH st AS (SELECT observstation, AVG(bandusagepct) AS avg_bw, COUNT(*) AS n FROM telescopes GROUP BY observstation), avgn AS (SELECT AVG(n) AS an FROM st) SELECT st.observstation, st.avg_bw, st.n, CAST(st.n AS REAL) / avgn.an AS ratio FROM st, avgn ORDER BY ratio DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 2.8925184404636464], ["Observatory-New Michael                                     ", 55.366666666666674, 3, 2.8925184404636464], ["Observatory-East Brett                                      ", 68.65, 2, 1.9283456269757642], ["Observatory-East Jeffrey                                    ", 20.75, 2, 1.9283456269757642], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 1.9283456269757642], ["Observatory-East Samantha                                   ", 46.1, 2, 1.9283456269757642], ["Observatory-Jamesberg                                       ", 12.95, 2, 1.9283456269757642], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 1.9283456269757642], ["Observatory-Lake David                                      ", 9.6, 2, 1.9283456269757642], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 1.9283456269757642]], "rows_answer": 10}