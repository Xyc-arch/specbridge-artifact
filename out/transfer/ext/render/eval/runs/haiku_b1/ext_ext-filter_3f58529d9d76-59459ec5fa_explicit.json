{"key": "ext:ext-filter@3f58529d9d76-59459ec5fa|explicit", "final": "WITH s1 AS (SELECT r.name AS name, AVG(ds.points) AS a FROM driverStandings ds JOIN races r ON r.raceId = ds.raceId WHERE ds.points > 1.0 GROUP BY r.name), s2 AS (SELECT AVG(a) AS b FROM s1) SELECT s1.name, s1.a, s1.a - s2.b AS diff FROM s1 JOIN s2 ON s2.b IS NOT NULL WHERE s1.a > s2.b", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Abu Dhabi Grand Prix", 99.31987577639751, 71.96919110201793], ["Azerbaijan Grand Prix", 47.529411764705884, 20.178727090326312], ["Brazilian Grand Prix", 43.833686440677965, 16.483001766298393], ["Hungarian Grand Prix", 32.0793499043977, 4.72866523001813], ["Indian Grand Prix", 97.07692307692308, 69.72623840254352], ["Japanese Grand Prix", 41.30670103092783, 13.956016356548261], ["Korean Grand Prix", 90.87142857142857, 63.520743897048995], ["Mexican Grand Prix", 31.202846975088967, 3.852162300709395], ["Russian Grand Prix", 62.492063492063494, 35.14137881768392], ["Singapore Grand Prix", 71.3764367816092, 44.02575210722963], ["Turkish Grand Prix", 28.259090909090908, 0.908406234711336], ["United States Grand Prix", 30.33157099697885, 2.9808863225992788]], "rows_answer": 12}