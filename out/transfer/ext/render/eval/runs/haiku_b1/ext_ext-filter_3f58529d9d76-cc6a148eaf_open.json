{"key": "ext:ext-filter@3f58529d9d76-cc6a148eaf|open", "final": "SELECT a.account_id, a.frequency, AVG(CASE WHEN t.type = 'PRIJEM' THEN t.amount WHEN t.type = 'VYDAJ' THEN -t.amount END) AS avg_signed_amount, AVG(t.balance) AS avg_balance FROM trans t JOIN account a ON a.account_id = t.account_id WHERE t.amount >= 2400 GROUP BY a.account_id, a.frequency ORDER BY avg_balance DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [[8212, "POPLATEK PO OBRATU", 2951.568281938326, 83935.82899628252], [4321, "POPLATEK MESICNE", 2548.5114503816794, 82358.78807947019], [1953, "POPLATEK TYDNE", 1374.8529411764705, 80459.01408450704], [2170, "POPLATEK PO OBRATU", 1613.7490494296578, 79122.4768683274], [2838, "POPLATEK TYDNE", 1100.1914191419141, 79074.07166123779], [2471, "POPLATEK MESICNE", 1342.4010152284263, 78956.59905660378], [211, "POPLATEK MESICNE", 1321.2545454545455, 78824.45614035087], [1610, "POPLATEK MESICNE", 501.7926829268293, 78786.78861788618], [8856, "POPLATEK MESICNE", 1212.5450236966824, 78451.76712328767], [3507, "POPLATEK MESICNE", 2423.9761904761904, 78220.82394366198]], "rows_answer": 10}