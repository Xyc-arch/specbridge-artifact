{"key": "ext:ext-filter@3f58529d9d76-d565098459|precise_other", "final": "SELECT o.observstation, o.lunarstage, COUNT(t.telescregistry) AS telescope_count FROM telescopes t INNER JOIN observatories o ON t.observstation = o.observstation WHERE t.bandusagepct >= 47.6 GROUP BY o.observstation, o.lunarstage ORDER BY telescope_count DESC, o.observstation, o.lunarstage LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Brett                                      ", "First Quarter", 2], ["Observatory-East Michael                                    ", "Last Quarter", 2], ["Observatory-Lake Josephview                                 ", "First Quarter", 2], ["Observatory-New Michael                                     ", "First Quarter", 2], ["Observatory-North Michael                                   ", "New", 2], ["Observatory-Ryanland                                        ", "Full", 2], ["Observatory-Sullivanmouth                                   ", "New", 2], ["Observatory-West Richard                                    ", "New", 2], ["Observatory-Adrianfurt                                      ", "First Quarter", 1], ["Observatory-Aguirreside                                     ", "Last Quarter", 1]], "rows_answer": 10}