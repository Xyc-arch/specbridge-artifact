{"key": "ext:ext-filter@3f58529d9d76-938a0f3041|explicit", "final": "WITH s1 AS (SELECT observstation AS obs, AVG(bandusagepct) AS avgband, COUNT(*) AS cnt FROM telescopes GROUP BY observstation), s2 AS (SELECT AVG(cnt) AS avgcnt FROM s1) SELECT s1.obs, s1.avgband, s1.cnt, CAST(s1.cnt AS REAL) / s2.avgcnt AS ratio FROM s1 CROSS JOIN s2 WHERE s2.avgcnt IS NOT NULL ORDER BY (CAST(s1.cnt AS REAL) / s2.avgcnt) IS NULL, ratio DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["Observatory-East Michael                                    ", 57.166666666666664, 3, 2.8925184404636464], ["Observatory-New Michael                                     ", 55.366666666666674, 3, 2.8925184404636464], ["Observatory-East Brett                                      ", 68.65, 2, 1.9283456269757642], ["Observatory-East Jeffrey                                    ", 20.75, 2, 1.9283456269757642], ["Observatory-East Kevin                                      ", 30.700000000000003, 2, 1.9283456269757642], ["Observatory-East Samantha                                   ", 46.1, 2, 1.9283456269757642], ["Observatory-Jamesberg                                       ", 12.95, 2, 1.9283456269757642], ["Observatory-Juanville                                       ", 9.299999999999999, 2, 1.9283456269757642], ["Observatory-Lake David                                      ", 9.6, 2, 1.9283456269757642], ["Observatory-Lake Josephview                                 ", 62.099999999999994, 2, 1.9283456269757642]], "rows_answer": 10}