{"key": "eval12:eval12@01cfbb1e713f-c1a8ce4d18|precise", "final": "WITH c AS (SELECT ci.location AS city, COUNT(DISTINCT r.raceId) AS cnt FROM circuits ci JOIN races r ON r.circuitId = ci.circuitId WHERE r.raceId IN (SELECT raceId FROM qualifying) GROUP BY ci.location), s AS (SELECT city, cnt, cnt * 1.0 / (SELECT SUM(cnt) FROM c) AS share FROM c) SELECT city, cnt AS race_count, share, share - (SELECT AVG(share) FROM s) AS above_avg FROM s WHERE share > (SELECT AVG(share) FROM s) ORDER BY share DESC", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["S\u0323o Paulo", 21, 0.06086956521739131, 0.03229813664596274], ["Melbourne", 20, 0.057971014492753624, 0.029399585921325057], ["Silverstone", 20, 0.057971014492753624, 0.029399585921325057], ["Montmel_", 19, 0.05507246376811594, 0.026501035196687374], ["Monte-Carlo", 18, 0.05217391304347826, 0.02360248447204969], ["Budapest", 17, 0.04927536231884058, 0.020703933747412015], ["Montreal", 17, 0.04927536231884058, 0.020703933747412015], ["Monza", 17, 0.04927536231884058, 0.020703933747412015], ["Suzuka", 17, 0.04927536231884058, 0.020703933747412015], ["Kuala Lumpur", 16, 0.0463768115942029, 0.017805383022774332], ["Spa", 16, 0.0463768115942029, 0.017805383022774332], ["Shanghai", 14, 0.04057971014492753, 0.012008281573498966], ["Hockenheim", 13, 0.03768115942028986, 0.00910973084886129], ["Sakhir", 13, 0.03768115942028986, 0.00910973084886129], ["Imola", 10, 0.028985507246376812, 0.0004140786749482449], ["Marina Bay", 10, 0.028985507246376812, 0.0004140786749482449], ["N_rburg", 10, 0.028985507246376812, 0.0004140786749482449]], "rows_answer": 17}