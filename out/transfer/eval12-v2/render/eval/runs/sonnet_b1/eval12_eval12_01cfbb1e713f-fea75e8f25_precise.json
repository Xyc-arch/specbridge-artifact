{"key": "eval12:eval12@01cfbb1e713f-fea75e8f25|precise", "final": "WITH e AS (SELECT equipref, AVG(humepct) AS a FROM scanenvironment GROUP BY equipref), g AS (SELECT AVG(a) AS ga FROM e WHERE a IS NOT NULL), k AS (SELECT e.equipref, e.a FROM e, g WHERE e.a > g.ga), km AS (SELECT AVG(a) AS ka FROM k) SELECT k.equipref, k.a AS avg_humidity, k.a - g.ga AS excess_over_overall, k.a - km.ka AS diff_from_kept_mean FROM k, g, km WHERE g.ga IS NOT NULL AND km.ka IS NOT NULL ORDER BY diff_from_kept_mean DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["SN16838                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN21406                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN88255                                           ", 89.9, 34.25704934541805, 17.331017612524448], ["SN41485                                           ", 89.8, 34.15704934541804, 17.23101761252444], ["SN64180                                           ", 89.7, 34.057049345418044, 17.131017612524445], ["SN66318                                           ", 89.6, 33.957049345418035, 17.031017612524437], ["SN45393                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN48591                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN63864                                           ", 89.4, 33.75704934541805, 16.831017612524448], ["SN32865                                           ", 89.3, 33.65704934541804, 16.73101761252444]], "rows_answer": 10}