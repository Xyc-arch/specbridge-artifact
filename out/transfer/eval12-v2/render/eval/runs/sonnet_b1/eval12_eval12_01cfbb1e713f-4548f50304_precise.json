{"key": "eval12:eval12@01cfbb1e713f-4548f50304|precise", "final": "SELECT d.district_id, d.A3 AS region, COUNT(*) AS client_count, CAST(COUNT(*) AS REAL) / SUM(COUNT(*)) OVER (PARTITION BY d.A3) AS share_of_region, CAST(COUNT(*) AS REAL) / SUM(COUNT(*)) OVER () AS share_of_total FROM client c JOIN district d ON d.district_id = c.district_id GROUP BY d.district_id, d.A3 ORDER BY share_of_total DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[1, "Prague", 663, 1.0, 0.1234866828087167], [74, "north Moravia", 180, 0.1956521739130435, 0.033525796237660645], [70, "north Moravia", 169, 0.18369565217391304, 0.031476997578692496], [54, "south Moravia", 155, 0.16542155816435433, 0.028869435649096668], [64, "south Moravia", 109, 0.11632870864461047, 0.020301732166138946], [72, "north Moravia", 104, 0.11304347826086956, 0.01937046004842615], [68, "north Moravia", 86, 0.09347826086956522, 0.016017880424660087], [46, "east Bohemia", 76, 0.11515151515151516, 0.014155336189234494], [52, "east Bohemia", 73, 0.11060606060606061, 0.013596572918606817], [5, "central Bohemia", 71, 0.10692771084337349, 0.013224064071521699]], "rows_answer": 10}