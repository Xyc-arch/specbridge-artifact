{"key": "eval12:eval12@01cfbb1e713f-1c7e18597b|open", "final": "WITH c AS (SELECT observstation, COUNT(*) AS n FROM telescopes GROUP BY observstation), s AS (SELECT observstation, n, n*1.0/(SELECT COUNT(*) FROM telescopes) AS share FROM c) SELECT observstation, n AS telescope_count, share, share - (SELECT AVG(share) FROM s) AS diff_from_avg FROM s WHERE share > (SELECT AVG(share) FROM s) ORDER BY diff_from_avg DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-East Michael                                    ", 3, 0.003161222339304531, 0.002068326164441155], ["Observatory-New Michael                                     ", 3, 0.003161222339304531, 0.002068326164441155], ["Observatory-East Brett                                      ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-East Jeffrey                                    ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-East Kevin                                      ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-East Samantha                                   ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-Jamesberg                                       ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-Juanville                                       ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-Lake David                                      ", 2, 0.002107481559536354, 0.0010145853846729774], ["Observatory-Lake Josephview                                 ", 2, 0.002107481559536354, 0.0010145853846729774]], "rows_answer": 10}