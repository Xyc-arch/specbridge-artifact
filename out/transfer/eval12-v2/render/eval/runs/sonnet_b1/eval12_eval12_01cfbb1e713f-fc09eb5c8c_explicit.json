{"key": "eval12:eval12@01cfbb1e713f-fc09eb5c8c|explicit", "final": "WITH s1 AS (SELECT AlbumId AS a, AVG(UnitPrice) AS p, CAST(SUM(Bytes) AS REAL) / NULLIF(SUM(Milliseconds), 0) AS r FROM Track GROUP BY AlbumId), s2 AS (SELECT AVG(r) AS m FROM s1) SELECT s1.a, s1.p, s1.r, s1.r - s2.m AS d FROM s1 JOIN s2 ON s2.m IS NOT NULL ORDER BY d DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[249, 1.99, 201.92181276773744, 168.4195382412945], [251, 1.9900000000000002, 199.7210712868499, 166.21879676040697], [250, 1.99, 199.46653076179155, 165.9642562353486], [254, 1.99, 198.29213782522265, 164.78986329877972], [228, 1.9900000000000002, 197.07709585711459, 163.57482133067165], [229, 1.9900000000000004, 196.95023938244788, 163.44796485600494], [261, 1.9899999999999995, 195.31369897558386, 161.81142444914093], [231, 1.9900000000000002, 195.05503075219383, 161.5527562257509], [227, 1.9899999999999998, 190.5754962662143, 157.07322173977136], [226, 1.99, 187.14859109543332, 153.6463165689904]], "rows_answer": 10}