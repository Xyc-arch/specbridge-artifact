{"key": "eval12:eval12@01cfbb1e713f-b12e0b112e|explicit", "final": "WITH s1 AS (SELECT account_id, AVG(amount) AS a FROM trans GROUP BY account_id), s2 AS (SELECT AVG(a) AS b FROM s1) SELECT s1.account_id, s1.a, s1.a - s2.b FROM s1 JOIN s2 ON s2.b IS NOT NULL WHERE s1.a > s2.b ORDER BY s1.a - s2.b DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[1935, 21062.685314685314, 15304.930159801635], [2384, 21011.225531914894, 15253.470377031215], [2211, 20842.66153846154, 15084.906383577862], [3634, 20287.188118811882, 14529.432963928204], [2633, 19789.189655172413, 14031.434500288735], [7049, 19772.473684210527, 14014.718529326849], [4514, 19181.50303030303, 13423.74787541935], [3516, 19140.80459770115, 13383.049442817472], [2532, 19029.503759398496, 13271.748604514818], [456, 18962.899224806202, 13205.144069922524]], "rows_answer": 10}