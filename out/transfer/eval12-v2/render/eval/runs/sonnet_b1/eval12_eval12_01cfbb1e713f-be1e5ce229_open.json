{"key": "eval12:eval12@01cfbb1e713f-be1e5ce229|open", "final": "SELECT event_id, location, avg_ratio, rnk FROM (SELECT e.event_id AS event_id, e.location AS location, AVG((b.spent - b.amount) * 1.0 / NULLIF(b.amount, 0)) AS avg_ratio, RANK() OVER (PARTITION BY e.location ORDER BY AVG((b.spent - b.amount) * 1.0 / NULLIF(b.amount, 0)) DESC) AS rnk FROM event e LEFT JOIN budget b ON b.link_to_event = e.event_id GROUP BY e.event_id, e.location) WHERE rnk <= 3 ORDER BY location, rnk, event_id", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["recJ4Witp9tpjaugn", null, 0.009999999999999964, 1], ["recc8dizaKrSz3GmH", null, 0.009999999999999964, 1], ["rec0akZnLLpGUloLH", null, -1.0, 3], ["rec180D2MI4EpckHy", null, -1.0, 3], ["recLrY8kyOR1PcZeF", null, -1.0, 3], ["recWJFyajeK4jCNYz", null, -1.0, 3], ["recqh5zxHuDpKUu0i", "100 W. Main Street", null, 1], ["recvCUOytx5jPw7kh", "100 W. Main Street", null, 1], ["recsgSUqFCJqekzL5", "1308 106th Ave.", null, 1], ["recSdU7jGu57676tT", "258 S. Maple St.", null, 1], ["recoVo6dFSzG1ypX7", "45 N. Smith St.", null, 1], ["rec5XDvJLyxDsGZWc", "900 E. Washington St.", null, 1], ["recJcyZUsdhK2ukaY", "900 E. Washington St.", null, 1], ["recyYo8ZxGg9oJGys", "Campus Baseball Stadium", null, 1], ["recLKj8BbTNqxFbTb", "Campus Common", -0.01626666666666665, 1], ["recGxVCwaLW3mDIa3", "Campus Football stadium", null, 1], ["recIuIXdbLe5j5vCA", "Campus Football stadium", null, 1], ["rec2N69DMcrqN9PJC", "Campus Soccer/Lacrosse stadium", null, 1], ["recQym2V7XkIEFFnr", "Campus Soccer/Lacrosse stadium", null, 1], ["receBpqENOUMQYsIP", "Campus Soccer/Lacrosse stadium", null, 1], ["reckYL4xtQWpkTJ8k", "Conference Room BA 452", null, 1], ["rectsBOijA23838qh", "Conference Room BA 452", null, 1], ["recmbOVHSyzXQZpQr", "MU 215", 0.0740151515151515, 1], ["recMKjJbWRgSQqf4Y", "MU 215", 0.009999999999999964, 2], ["recggMW2eyCYceNcy", "MU 215", -0.10301818181818181, 3], ["recmvq6ZguK4MVmvx", "Various locations", null, 1]], "rows_answ