{"key": "eval12:eval12@01cfbb1e713f-3b551d13a2|open", "final": "SELECT account_id, AVG(CASE WHEN type IN ('PRIJEM','VYDAJ') THEN amount END) AS avg_amount, COUNT(*) AS txn_count, COUNT(*) * 1.0 / (SELECT COUNT(*) * 1.0 / COUNT(DISTINCT account_id) FROM trans) AS ratio FROM trans GROUP BY account_id ORDER BY ratio DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [[8261, 4684.055472263868, 675, 2.875549076037564], [3834, 3333.6015037593984, 665, 2.832948348985156], [96, 9979.1872, 661, 2.8159080581641924], [2932, 8495.365354330708, 655, 2.7903476219327477], [9307, 7385.360655737705, 649, 2.7647871857013024], [9265, 8626.285261489698, 643, 2.7392267494698577], [5215, 3495.2119309262166, 637, 2.7136663132384125], [2762, 11499.765957446809, 634, 2.7008860951226903], [1801, 7333.330605564648, 633, 2.6966260224174494], [5952, 7558.862354892206, 628, 2.675325658891245]], "rows_answer": 10}