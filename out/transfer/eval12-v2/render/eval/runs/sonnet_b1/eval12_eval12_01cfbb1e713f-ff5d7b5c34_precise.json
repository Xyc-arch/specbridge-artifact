{"key": "eval12:eval12@01cfbb1e713f-ff5d7b5c34|precise", "final": "WITH pairs AS (SELECT f.orderslink AS orderslink, u.acctscope AS acctscope, AVG(f.feerate) AS avg_rate FROM fees f JOIN orders o ON f.orderslink = o.recordvault JOIN users u ON o.userlink = u.userstamp GROUP BY f.orderslink, u.acctscope), m AS (SELECT AVG(avg_rate) AS mean_rate FROM pairs), kept AS (SELECT p.orderslink, p.acctscope, p.avg_rate, p.avg_rate - m.mean_rate AS excess FROM pairs p, m WHERE p.avg_rate > m.mean_rate), ranked AS (SELECT orderslink, acctscope, avg_rate, excess, RANK() OVER (PARTITION BY acctscope ORDER BY excess DESC) AS rnk FROM kept) SELECT orderslink, acctscope, avg_rate, excess, rnk FROM ranked WHERE rnk <= 3 ORDER BY acctscope, rnk, orderslink", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["OB696050                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB789898                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB831859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB867292                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB889157                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB913859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB953471                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB236106                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB258847                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB494562                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB619793                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB797782                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB132575                            ", "Options", 0.002, 0.0009889889889889913, 1], ["OB271476                            ", "Options", 0.002, 0