{"key": "eval12:eval12@01cfbb1e713f-e7b2c8e815|precise_other", "final": "WITH s AS (SELECT observstation, AVG(bandusagepct) AS avg_bw FROM telescopes GROUP BY observstation), o AS (SELECT AVG(avg_bw) AS overall FROM s WHERE avg_bw IS NOT NULL) SELECT s.observstation, s.avg_bw, s.avg_bw - o.overall AS diff_above_overall FROM s, o WHERE s.avg_bw > o.overall ORDER BY diff_above_overall DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["Observatory-Elizabethfort                                   ", 99.9, 50.81548269581056], ["Observatory-Lake Todd                                       ", 99.6, 50.51548269581055], ["Observatory-West Dawnville                                  ", 99.6, 50.51548269581055], ["Observatory-Stephenbury                                     ", 99.3, 50.21548269581055], ["Observatory-North Stephanie                                 ", 99.0, 49.91548269581055], ["Observatory-Port Emily                                      ", 98.9, 49.81548269581056], ["Observatory-Herreraberg                                     ", 98.8, 49.71548269581055], ["Observatory-West Joseph                                     ", 98.6, 49.51548269581055], ["Observatory-Bakerchester                                    ", 98.5, 49.41548269581055], ["Observatory-Hineshaven                                      ", 98.5, 49.41548269581055]], "rows_answer": 10}