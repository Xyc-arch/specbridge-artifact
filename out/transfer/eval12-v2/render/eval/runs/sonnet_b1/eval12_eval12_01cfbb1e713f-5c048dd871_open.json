{"key": "eval12:eval12@01cfbb1e713f-5c048dd871|open", "final": "SELECT m.member_id, m.position, COUNT(*) AS attendance_count, COUNT(*) * 1.0 / (SELECT COUNT(*) FROM attendance a2 JOIN member m2 ON m2.member_id = a2.link_to_member) AS share FROM attendance a JOIN member m ON m.member_id = a.link_to_member GROUP BY m.member_id, m.position ORDER BY share DESC LIMIT 10", "turns": 1, "batch_size": 1, "model": "sonnet", "executes": true, "answer": [["recD078PnS3x2doBe", "Vice President", 16, 0.049079754601226995], ["recro8T1MPMwRadVH", "Treasurer", 16, 0.049079754601226995], ["rec4BLdZHS2Blfp4v", "President", 14, 0.04294478527607362], ["recEFd8s6pkrTt4Pz", "Member", 14, 0.04294478527607362], ["recTjHY5xXhvkCdVT", "Member", 14, 0.04294478527607362], ["recZ4PkGERzl9ziHO", "Member", 14, 0.04294478527607362], ["recP6DJPyi5donvXL", "Member", 13, 0.03987730061349693], ["rec28ORZgcm1dtqBZ", "Member", 12, 0.03680981595092025], ["rec75vvFxgYtHmqxY", "Member", 12, 0.03680981595092025], ["recT92PyyZCGq1R68", "Member", 12, 0.03680981595092025]], "rows_answer": 10}