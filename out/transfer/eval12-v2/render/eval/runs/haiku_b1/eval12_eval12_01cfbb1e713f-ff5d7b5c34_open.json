{"key": "eval12:eval12@01cfbb1e713f-ff5d7b5c34|open", "final": "WITH pair_avgs AS (\n  SELECT \n    f.orderslink,\n    u.acctscope,\n    AVG(f.feerate) as avg_feerate\n  FROM fees f\n  INNER JOIN orders o ON f.orderslink = o.recordvault\n  INNER JOIN users u ON o.userlink = u.userstamp\n  GROUP BY f.orderslink, u.acctscope\n),\noverall_mean AS (\n  SELECT AVG(avg_feerate) as mean_rate FROM pair_avgs\n),\nfiltered_ranked AS (\n  SELECT \n    pa.orderslink,\n    pa.acctscope,\n    pa.avg_feerate,\n    pa.avg_feerate - om.mean_rate as excess,\n    RANK() OVER (PARTITION BY pa.acctscope ORDER BY (pa.avg_feerate - om.mean_rate) DESC) as rank_in_scope\n  FROM pair_avgs pa\n  CROSS JOIN overall_mean om\n  WHERE pa.avg_feerate > om.mean_rate\n)\nSELECT \n  orderslink,\n  acctscope,\n  avg_feerate,\n  excess,\n  rank_in_scope\nFROM filtered_ranked\nWHERE rank_in_scope <= 3\nORDER BY acctscope, rank_in_scope", "turns": 3, "batch_size": 1, "model": "haiku", "executes": true, "answer": [["OB696050                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB789898                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB831859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB867292                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB889157                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB913859                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB953471                            ", "Futures", 0.002, 0.0009889889889889913, 1], ["OB236106                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB258847                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB494562                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB619793                            ", "Margin", 0.002, 0.0009889889889889913, 1], ["OB797782                            ", "Margin", 0.002, 0.00098898